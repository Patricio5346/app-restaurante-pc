{
  "name": "app-restaurante-pc",
  "version": "1.0.0",
  "description": "D'COMPRAS by FREYSA Desktop Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.freysa.compras",
    "productName": "D'COMPRAS by FREYSA",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "DCOMPRAS.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "allowElevation": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  }
}
